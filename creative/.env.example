# Creative Intelligence Agent: copy to .env (or set in start-creative.bat). Everything runs without any key; keys add providers.
CREATIVE_PORT=3200
# where records, screenshots, uploads and generated files live (default: creative/data)
# CREATIVE_DATA_DIR=C:\path\to\data

# Image generation backdrops (the real product photo is always composited on top; words are drawn by the text layer)
#   composite needs nothing. gemini: a key from Google AI Studio. higgsfield: your account's API key and text-to-image endpoint.
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# HIGGSFIELD_API_KEY=
# HIGGSFIELD_API_URL=https://.../text-to-image

# Optional language model for the labelled interpretation in analyses and for tightening concept copy
# ANTHROPIC_API_KEY=
# CREATIVE_MODEL=claude-sonnet-5
