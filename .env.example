# Mytekkstore server settings. Copy to the host's environment (Vercel: Project Settings, Environment Variables). Never commit real values.
# ── sign-in ──
GOOGLE_CLIENT_ID=            # Google Cloud OAuth client id (web). Authorised origins: https://mytekkstore.vercel.app and http://localhost:3000
BREVO_API_KEY=               # email codes and order mails (optional)
MAIL_FROM=
TWILIO_ACCOUNT_SID=          # SMS or WhatsApp codes (optional)
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_COUNTRY_CODE=+91
OTP_DEMO=                    # 1 shows sign-in codes on the page for a walkthrough; never on a live site
ADMIN_PASSWORD=              # the admin sign-in; a random one is generated when empty (local only)
# ── payments (Razorpay standard checkout; test keys first, live keys after approval) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=     # set the webhook to https://<site>/api/pay/webhook for order.paid, payment.captured, payment.failed
# ── the shopping assistant (free tier first; the page's catalogue rules answer when neither is set) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-4-5-20251001
# ── analytics ──
CLARITY_ID=
# ── hosting ──
TRUST_PROXY=1                # behind Vercel or any proxy, so rate limits use the visitor's address
DATA_DIR=                    # where users, orders and banners are stored; a shared database replaces this (docs/INTEGRATIONS.md)
