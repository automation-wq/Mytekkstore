# Copy this file to .env and paste your key. Never commit .env (it is in .gitignore).
# Free key: https://aistudio.google.com/apikey  (Google AI Studio; the free tier covers these 15 pictures)
GEMINI_API_KEY=

# Optional. Default: gemini-nano-banana-2.1 (Google's current image model). The older gemini-2.5-flash-image also works.
GEMINI_IMAGE_MODEL=
